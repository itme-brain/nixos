version = 1

[*]
flash-attn = on
jinja = true
threads = 24
threads-batch = 12
cache-type-k = f16
cache-type-v = f16
parallel = 1
n-gpu-layers = 999
temp = 1.0
top-p = 0.95
top-k = 20
min-p = 0.0
presence-penalty = 0.0
repeat-penalty = 1.0
reasoning = auto
reasoning-preserve = true

[Qwen3.8-27B]
model = {{ llama_models }}/Qwen/{{ qwen_file }}
chat-template-file = {{ llama_models }}/Qwen/etc/chat_template.jinja
load-on-startup = true
ctx-size = 131072
n-gpu-layers-draft = 999
no-cache-idle-slots = true
ctx-checkpoints = 64
checkpoint-min-step = 256
cache-ram = 32768
reasoning-format = deepseek
no-mmproj = true
spec-type = draft-mtp
spec-draft-n-max = 2
spec-draft-n-min = 1
spec-draft-type-k = f16
spec-draft-type-v = f16

